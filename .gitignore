# --- Personendaten: NIEMALS einchecken ---------------------------------
# Suchprofile enthalten CV-Texte und Angaben zu realen Personen.
# Nur profiles/example.yaml (erfundene Werte) gehört ins Repo.
profiles/*
!profiles/example.yaml
!profiles/README.md

# --- Daten -------------------------------------------------------------
# Rohdaten und DB bleiben lokal: Inseratsinhalte werden nicht weiterverbreitet.
data/raw/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/cache/
drafts/

# Digests enthalten Inseratstexte fremder Arbeitgeber. Sie bleiben lokal —
# das Repo enthält Code, keine fremden Inhalte.
digests/

# Referenzdaten sind gross und ableitbar -> nicht eingecheckt.
# skills.yaml dagegen ist von Hand kuratiert und gehört ins Repo.
data/ref/berufe_ch.json
data/ref/plz_coords.csv

# --- Secrets -----------------------------------------------------------
.env
.env.local
*.key

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Editor / OS -------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
