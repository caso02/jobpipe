# Kopieren nach .env und ausfüllen. .env ist gitignored.

# --- Kontaktadresse im User-Agent --------------------------------------
# Wird bei JEDEM Request mitgeschickt, damit Portalbetreiber sehen, wer da
# unterwegs ist und uns erreichen können. Kein Spoofing, keine Tarnung.
JOBPIPE_CONTACT_URL=https://github.com/caso02/Bewerbungshilfe

# --- Embeddings (erst ab M3 nötig) -------------------------------------
# Ohne Key nutzt die Pipeline automatisch das lokale Modell (kostenlos).
# GEMINI_API_KEY=

# --- Optional: Lohn-Benchmark (erst ab M5) -----------------------------
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- Logging -----------------------------------------------------------
JOBPIPE_LOG_LEVEL=INFO
